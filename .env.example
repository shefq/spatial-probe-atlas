# Spatial Probe Atlas local overrides. Copy to .env.local; never commit that file.
# Runtime data is never stored in this repository.
SPA_DATA_ROOT=%LOCALAPPDATA%\SpatialProbeAtlas
SPA_PORT=8765
SPA_LOG_LEVEL=INFO
# auto selects verified CUDA when usable and otherwise falls back to CPU.
SPA_COMPUTE_PROFILE=auto
# The production host is intentionally fixed to loopback by tools/run.ps1.
